-- =========================================================
-- MAIN LOOP
-- =========================================================

local lastPeriodicSave = 0

RunService.RenderStepped:Connect(function()

	if miscSettings.PanicMode then
		return
	end

	-- Periodic settings save.
	-- This acts as an additional safety net for settings that
	-- may have been changed without a direct UI callback.
	if tick() - lastPeriodicSave >= 5 then
		SaveAllSettings()
		lastPeriodicSave = tick()
	end

	local center =
		Vector2.new(
			Camera.ViewportSize.X / 2,
			Camera.ViewportSize.Y / 2
		)

	AimbotFOVCircle.Position = center

	AimbotFOVCircle.Visible =
		aimbotSettings.ShowFOVCircle
		and aimbotSettings.Enabled

	AimbotFOVCircle.Radius =
		aimbotSettings.FOV

	TriggerFOVCircle.Position = center

	TriggerFOVCircle.Visible =
		triggerSettings.ShowFOV
		and triggerSettings.Enabled

	TriggerFOVCircle.Radius =
		triggerSettings.FOV

	-- =====================================================
	-- EXISTING AIMBOT BEHAVIOR
	-- =====================================================

	if aimbotSettings.Enabled then

		local isKeyPressed = false

		if aimbotSettings.AimKey then

			if typeof(
				aimbotSettings.AimKey
			) == "EnumItem" then

				if aimbotSettings.AimKey.EnumType
					== Enum.KeyCode then

					isKeyPressed =
						UserInputService:IsKeyDown(
							aimbotSettings.AimKey
						)

				elseif aimbotSettings.AimKey.EnumType
					== Enum.UserInputType then

					isKeyPressed =
						UserInputService:IsMouseButtonPressed(
							aimbotSettings.AimKey
						)
				end
			end
		end

		if isKeyPressed then

			local target =
				GetClosest()

			if target
				and target.Character
				and target.Character:FindFirstChild("Head") then

				local headPos =
					target.Character.Head.Position

				if aimbotSettings.Predict > 0 then

					local root =
						target.Character:FindFirstChild(
							"HumanoidRootPart"
						)

					if root then
						headPos =
							headPos
							+ root.Velocity
							* aimbotSettings.Predict
					end
				end

				local pos, onScreen =
					Camera:WorldToViewportPoint(
						headPos
					)

				if onScreen then

					local mouse =
						UserInputService:GetMouseLocation()

					local dx =
						pos.X - mouse.X

					local dy =
						pos.Y - mouse.Y

					local s =
						math.max(
							aimbotSettings.Smoothness,
							0.1
						)

					mousemoverel(
						dx / s,
						dy / s
					)
				end
			end
		end
	end

	-- =====================================================
	-- TRIGGERBOT
	-- =====================================================

	if triggerSettings.Enabled then

		local inCrosshair, target =
			IsEnemyInCrosshair()

		if inCrosshair then

			local delay =
				triggerSettings.Delay

			if triggerSettings.RandomDelay then

				delay =
					math.random(
						triggerSettings.MinDelay * 1000,
						triggerSettings.MaxDelay * 1000
					) / 1000
			end

			if delay > 0 then
				task.wait(delay)
			end

			local stillInCrosshair =
				IsEnemyInCrosshair()

			if stillInCrosshair then
				VirtualClick()
			end
		end
	end

	-- =====================================================
	-- TRACERS
	-- =====================================================

	if visualSettings.Tracers.Enabled then

		local tracerCenter =
			Camera.ViewportSize / 2

		for player, tracer in pairs(tracers) do

			if player.Character
				and player.Character:FindFirstChild(
					"HumanoidRootPart"
				) then

				local root =
					player.Character.HumanoidRootPart

				local pos, onScreen =
					Camera:WorldToViewportPoint(
						root.Position
					)

				if onScreen then

					tracer.From =
						visualSettings.Tracers.FromCenter
						and Vector2.new(
							tracerCenter.X,
							tracerCenter.Y
						)
						or Vector2.new(0, 0)

					tracer.To =
						Vector2.new(
							pos.X,
							pos.Y
						)

					tracer.Visible = true
				else
					tracer.Visible = false
				end
			else
				tracer.Visible = false
			end
		end
	end

	updateHealthESP()

	if visualSettings.NameTags.Enabled then

		for _, player in Players:GetPlayers() do

			if player ~= Players.LocalPlayer then

				if not nameTags[player]
					and player.Character
					and player.Character:FindFirstChild(
						"Head"
					) then

					createNameTag(player)
				end
			end
		end
	end
end)

