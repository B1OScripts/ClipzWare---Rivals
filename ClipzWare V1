local nameTags = {}

local function createNameTag(player)
	if player == Players.LocalPlayer
		or not player.Character then
		return
	end

	local head = player.Character:FindFirstChild("Head")

	if not head then
		return
	end

	if nameTags[player]
		and nameTags[player].billboard then

		nameTags[player].billboard:Destroy()
		nameTags[player] = nil
	end

	local billboard = Instance.new("BillboardGui")

	billboard.Name = "ClipzNameTag"
	billboard.Adornee = head
	billboard.Size = UDim2.new(0, 100, 0, 30)
	billboard.StudsOffset =
		Vector3.new(0, 2.5, 0)
	billboard.AlwaysOnTop = true
	billboard.ZIndexBehavior =
		Enum.ZIndexBehavior.Sibling
	billboard.ResetOnSpawn = false
	billboard.Parent = player.Character

	local frame = Instance.new("Frame")

	frame.Size = UDim2.new(1, 0, 1, 0)
	frame.BackgroundTransparency = 1
	frame.Parent = billboard

	local label = Instance.new("TextLabel")

	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = player.Name

	if FriendSystem:IsFriend(player.UserId) then
		label.TextColor3 =
			Color3.fromRGB(0, 255, 0)
	else
		label.TextColor3 =
			visualSettings.ESP.Color
	end

	label.TextScaled = true
	label.Font = Enum.Font.Code

	label.TextStrokeTransparency =
		visualSettings.NameTags.Outline
		and 0.5
		or 1

	label.Parent = frame

	nameTags[player] = {
		billboard = billboard,
		label = label
	}

	return nameTags[player]
end

local function updateNameTags()
	for _, player in Players:GetPlayers() do
		if player ~= Players.LocalPlayer then

			if visualSettings.NameTags.Enabled
				and not miscSettings.PanicMode then

				if not nameTags[player]
					and player.Character
					and player.Character:FindFirstChild("Head") then

					createNameTag(player)

				elseif nameTags[player]
					and nameTags[player].label then

					if FriendSystem:IsFriend(player.UserId) then
						nameTags[player].label.TextColor3 =
							Color3.fromRGB(0, 255, 0)
					else
						nameTags[player].label.TextColor3 =
							visualSettings.ESP.Color
					end

					nameTags[player].label.TextStrokeTransparency =
						visualSettings.NameTags.Outline
						and 0.5
						or 1
				end

			elseif nameTags[player] then

				if nameTags[player].billboard then
					nameTags[player].billboard:Destroy()
				end

				nameTags[player] = nil
			end
		end
	end
end

