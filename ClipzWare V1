local cleanedUp = false

local function CleanupClipzWare()
	if cleanedUp then
		return
	end

	cleanedUp = true

	-- Save everything one final time.
	pcall(function()
		SaveAllSettings()
	end)

	pcall(function()
		FriendSystem:Save()
	end)

	pcall(function()
		if AimbotFOVCircle then
			AimbotFOVCircle:Remove()
		end
	end)

	pcall(function()
		if TriggerFOVCircle then
			TriggerFOVCircle:Remove()
		end
	end)

	pcall(function()
		if aspectConnection then
			aspectConnection:Disconnect()
			aspectConnection = nil
		end
	end)

	pcall(function()
		for _, tracer in pairs(tracers) do
			tracer:Remove()
		end
	end)

	pcall(function()
		for _, highlight in pairs(highlights) do
			highlight:Destroy()
		end
	end)

	pcall(function()
		for _, info in pairs(nameTags) do
			if info.billboard then
				info.billboard:Destroy()
			end
		end
	end)

	pcall(function()
		for _, info in pairs(healthESPs) do
			if info.billboard then
				info.billboard:Destroy()
			end
		end
	end)
end

-- BindToClose is useful in environments where the script
-- receives the close/unload event.
pcall(function()
	game:BindToClose(CleanupClipzWare)
end)

-- Some executors expose getgenv(). We'll also expose a
-- cleanup function there when available.
pcall(function()
	if getgenv then
		getgenv().ClipzWareCleanup =
			CleanupClipzWare
	end
end)

