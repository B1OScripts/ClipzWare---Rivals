local function createPlayerEntry(
	player,
	isFriendList
)

	local frame = new("Frame", {
		Size = UDim2.new(1, -10, 0, 50),
		BackgroundColor3 =
			settings.colors.background,
		BorderSizePixel = 0,
		Parent =
			isFriendList
			and rightList
			or leftList
	})

	new("UIStroke", {
		Color = settings.colors.secondary,
		Thickness = 1,
		Transparency = 0.7,
		Parent = frame
	})

	local avatarContainer = new("Frame", {
		Size = UDim2.new(0, 40, 0, 40),
		Position = UDim2.new(0, 5, 0.5, -20),
		BackgroundColor3 =
			Color3.fromRGB(30, 30, 30),
		BorderSizePixel = 0,
		Parent = frame
	})

	local avatarImage = new("ImageLabel", {
		Size = UDim2.new(1, -2, 1, -2),
		Position = UDim2.new(0, 1, 0, 1),
		BackgroundColor3 =
			settings.colors.background,
		BorderSizePixel = 0,
		Parent = avatarContainer
	})

	pcall(function()
		local content =
			Players:GetUserThumbnailAsync(
				player.UserId,
				Enum.ThumbnailType.HeadShot,
				Enum.ThumbnailSize.Size48x48
			)

		avatarImage.Image = content
	end)

	new("TextLabel", {
		Size = UDim2.new(0, 120, 1, 0),
		Position = UDim2.new(0, 50, 0, 0),
		BackgroundTransparency = 1,
		Text = player.Name,
		TextColor3 =
			isFriendList
			and Color3.fromRGB(0, 255, 0)
			or settings.colors.text,
		Font = Enum.Font.Code,
		TextSize = 14,
		TextXAlignment =
			Enum.TextXAlignment.Left,
		TextTruncate =
			Enum.TextTruncate.AtEnd,
		Parent = frame
	})

	local actionButton = new("TextButton", {
		Size = UDim2.new(0, 60, 0, 25),
		Position = UDim2.new(
			1,
			-65,
			0.5,
			-12
		),

		BackgroundColor3 =
			isFriendList
			and Color3.fromRGB(150, 0, 0)
			or settings.colors.primary,

		BorderSizePixel = 0,
		Text =
			isFriendList
			and "REMOVE"
			or "ADD",

		TextColor3 =
			Color3.new(1, 1, 1),

		Font = Enum.Font.Code,
		TextSize = 12,
