local tracers = {}

local function updateTracers()
	for _, player in Players:GetPlayers() do
		if player ~= Players.LocalPlayer then

			if visualSettings.Tracers.Enabled
				and not miscSettings.PanicMode then

				if not tracers[player] then
					local tracer = Drawing.new("Line")

					tracer.Thickness =
						visualSettings.Tracers.Thickness
					tracer.Color =
						visualSettings.Tracers.Color
					tracer.Transparency =
						visualSettings.Tracers.Transparency
					tracer.Visible = true

					tracers[player] = tracer
				end

			elseif tracers[player] then
				tracers[player]:Remove()
				tracers[player] = nil
			end
		end
	end
end

