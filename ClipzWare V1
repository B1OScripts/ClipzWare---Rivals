		local targetColor =
			isFriendList
			and Color3.fromRGB(200, 0, 0)
			or Color3.fromRGB(0, 200, 100)

		TweenService:Create(
			actionButton,
			TweenInfo.new(0.2),
			{
				BackgroundColor3 = targetColor,
				Size = UDim2.new(0, 65, 0, 27)
