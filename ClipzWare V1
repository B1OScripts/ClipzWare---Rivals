local function updateHealthESP()
	for player, esp in pairs(healthESPs) do
		if esp
			and esp.humanoid
			and esp.humanoid.Parent
			and esp.label then

			local health =
				math.floor(esp.humanoid.Health)

			local maxHealth =
				math.floor(esp.humanoid.MaxHealth)

			esp.label.Text =
				health .. "/" .. maxHealth

			local percent =
				esp.humanoid.Health
				/ esp.humanoid.MaxHealth

			if percent > 0.6 then
				esp.label.TextColor3 =
					Color3.new(0, 1, 0)
			elseif percent > 0.3 then
				esp.label.TextColor3 =
					Color3.new(1, 1, 0)
			else
				esp.label.TextColor3 =
					Color3.new(1, 0, 0)
			end
		else
			if esp and esp.billboard then
				pcall(function()
					esp.billboard:Destroy()
				end)
			end

			healthESPs[player] = nil
		end
	end

	if visualSettings.HealthESP.Enabled
		and not miscSettings.PanicMode then

		for _, player in Players:GetPlayers() do
			if player ~= Players.LocalPlayer then
				if not healthESPs[player]
					and player.Character
					and player.Character:FindFirstChild("Head") then

