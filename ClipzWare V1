local function IsEnemyInCrosshair()
	local viewportSize =
		Camera.ViewportSize

	local center =
		Vector2.new(
			viewportSize.X / 2,
			viewportSize.Y / 2
		)

	local fovSize =
		triggerSettings.FOV

	for _, plr in Players:GetPlayers() do
		if IsTriggerTargetValid(plr)
			and plr.Character then

			local humanoid =
				plr.Character:FindFirstChildOfClass(
					"Humanoid"
				)

			if humanoid
				and humanoid.Health > 0 then

				local targetParts = {
					"Head",
					"UpperTorso",
					"LowerTorso",
					"HumanoidRootPart",
					"Torso"
				}

				for _, partName in ipairs(targetParts) do
					local part =
						plr.Character:FindFirstChild(
							partName
						)

					if part then
						local pos, onScreen =
							Camera:WorldToViewportPoint(
								part.Position
							)

						if onScreen then
							local dist =
								(
									Vector2.new(
										pos.X,
										pos.Y
									) - center
								).Magnitude

							if dist <= fovSize
								and IsEnemyVisible(part) then

								return true, plr
							end
						end
					end
				end
			end
		end
	end

	return false, nil
end

