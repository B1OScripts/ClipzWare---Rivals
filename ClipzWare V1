UserInputService.InputBegan:Connect(
	function(input, gameProcessed)

		if gameProcessed then
			return
		end

		if input.KeyCode == settings.toggleKey
			and not miscSettings.PanicMode then

			if isOpen then
				closeGui()
			else
				openGui()
			end
		end

		if not miscSettings.PanicMode then

			if aimbotSettings.ToggleKey then
				local keyPressed = false

				if typeof(
					aimbotSettings.ToggleKey
				) == "EnumItem" then

					if aimbotSettings.ToggleKey.EnumType
						== Enum.KeyCode then

						keyPressed =
							input.KeyCode
							== aimbotSettings.ToggleKey

					elseif aimbotSettings.ToggleKey.EnumType
						== Enum.UserInputType then

						keyPressed =
							input.UserInputType
							== aimbotSettings.ToggleKey
					end
				end

				if keyPressed then
					aimbotSettings.Enabled =
						not aimbotSettings.Enabled

					SettingsStore:Set(
						"AimbotEnabled",
						aimbotSettings.Enabled
					)

					aimbotStatusLabel.Text =
						aimbotSettings.Enabled
						and "Aimbot status: On"
						or "Aimbot status: Off"

					aimbotStatusLabel.TextColor3 =
						aimbotSettings.Enabled
						and settings.colors.primary
						or settings.colors.textDark

					AimbotFOVCircle.Visible =
						aimbotSettings.ShowFOVCircle
						and aimbotSettings.Enabled
				end
			end

			if triggerSettings.ToggleKey then
				local keyPressed = false

				if typeof(
					triggerSettings.ToggleKey
				) == "EnumItem" then

					if triggerSettings.ToggleKey.EnumType
						== Enum.KeyCode then

						keyPressed =
							input.KeyCode
							== triggerSettings.ToggleKey

					elseif triggerSettings.ToggleKey.EnumType
						== Enum.UserInputType then

						keyPressed =
							input.UserInputType
							== triggerSettings.ToggleKey
					end
				end

				if keyPressed then
					triggerSettings.Enabled =
						not triggerSettings.Enabled

					SettingsStore:Set(
