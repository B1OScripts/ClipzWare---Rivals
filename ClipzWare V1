-- =========================================================
-- WORLD TIME
-- =========================================================

local function updateWorldTime()
	if visualSettings.WorldTime.Enabled
		and not miscSettings.PanicMode then

		local targetTime =
			math.clamp(
				visualSettings.WorldTime.TimeOfDay,
				0,
				24
			)

		Lighting.ClockTime = targetTime

		if targetTime > 20
			or targetTime < 5 then

			Lighting.Brightness = 1.5
			Lighting.OutdoorAmbient =
				Color3.fromRGB(80, 80, 120)
			Lighting.Ambient =
				Color3.fromRGB(40, 40, 60)

		elseif targetTime > 17 then

			Lighting.Brightness = 2
			Lighting.OutdoorAmbient =
				Color3.fromRGB(150, 120, 100)
			Lighting.Ambient =
				Color3.fromRGB(100, 80, 70)

		elseif targetTime > 6 then

			Lighting.Brightness = 2.5
			Lighting.OutdoorAmbient =
				Color3.fromRGB(200, 200, 200)
			Lighting.Ambient =
				Color3.fromRGB(128, 128, 128)

		else

			Lighting.Brightness = 1.8
			Lighting.OutdoorAmbient =
				Color3.fromRGB(180, 140, 120)
			Lighting.Ambient =
				Color3.fromRGB(100, 80, 70)
		end
	else
		Lighting.ClockTime = 12
		Lighting.Brightness = 2
		Lighting.OutdoorAmbient =
			Color3.fromRGB(128, 128, 128)
		Lighting.Ambient =
			Color3.fromRGB(0, 0, 0)
	end
end

