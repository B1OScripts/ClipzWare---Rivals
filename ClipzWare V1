local highlights = {}

local function createHighlight(player)
	if player == Players.LocalPlayer then
		return
	end

	if player.Character then
		local existing = player.Character:FindFirstChild("ClipzESP")

		if existing then
			existing:Destroy()
		end

		local highlight = Instance.new("Highlight")
		highlight.Name = "ClipzESP"

		if FriendSystem:IsFriend(player.UserId) then
			highlight.FillColor = Color3.fromRGB(0, 255, 0)
			highlight.FillTransparency = 0.7
			highlight.OutlineColor = Color3.fromRGB(0, 200, 0)
			highlight.OutlineTransparency = 0.3
		else
			highlight.FillColor = visualSettings.ESP.FillColor
			highlight.FillTransparency =
				visualSettings.ESP.FillTransparency
			highlight.OutlineColor = visualSettings.ESP.Color
			highlight.OutlineTransparency =
				visualSettings.ESP.Transparency
		end

		highlight.DepthMode =
			Enum.HighlightDepthMode.AlwaysOnTop

		highlight.Adornee = player.Character
		highlight.Parent = player.Character

		highlights[player] = highlight

		return highlight
	end
end

local function updateESP()
	for _, player in Players:GetPlayers() do
		if player ~= Players.LocalPlayer then
			if visualSettings.ESP.Enabled
				and not miscSettings.PanicMode then

				if not highlights[player]
					and player.Character then

					createHighlight(player)

				elseif highlights[player] then
					local h = highlights[player]

					if FriendSystem:IsFriend(player.UserId) then
						h.FillColor =
							Color3.fromRGB(0, 255, 0)
						h.FillTransparency = 0.7
						h.OutlineColor =
							Color3.fromRGB(0, 200, 0)
						h.OutlineTransparency = 0.3
					else
						h.FillColor =
							visualSettings.ESP.FillColor
						h.FillTransparency =
							visualSettings.ESP.FillTransparency
						h.OutlineColor =
							visualSettings.ESP.Color
						h.OutlineTransparency =
							visualSettings.ESP.Transparency
					end
				end

			elseif highlights[player] then
				pcall(function()
					highlights[player]:Destroy()
				end)

				highlights[player] = nil
			end
		end
	end
end

