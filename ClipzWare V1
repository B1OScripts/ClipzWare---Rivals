local function createSlider(
	parent,
	text,
	min,
	max,
	defaultValue,
	unit,
	callback,
	settingsKey
)

	local frame = new("Frame", {
		Size = UDim2.new(1, 0, 0, 55),
		BackgroundTransparency = 1,
		Parent = parent
	})

	local label = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 =
			settings.colors.text,
		Font = Enum.Font.Code,
		TextSize = 14,
		TextXAlignment =
			Enum.TextXAlignment.Left,
		Parent = frame
	})

	local valueLabel = new("TextLabel", {
		Size = UDim2.new(0, 50, 0, 20),
		Position = UDim2.new(
			1,
			-50,
			0,
			0
		),
		BackgroundTransparency = 1,
		Text =
			tostring(defaultValue)
			.. (unit or ""),
		TextColor3 =
			settings.colors.primary,
		Font = Enum.Font.Code,
		TextSize = 14,
		TextXAlignment =
			Enum.TextXAlignment.Right,
		Parent = frame
	})

	local sliderBg = new("Frame", {
		Size = UDim2.new(1, 0, 0, 4),
		Position = UDim2.new(0, 0, 0, 25),
		BackgroundColor3 =
			settings.colors.backgroundLight,
		BorderSizePixel = 0,
		Parent = frame
	})

	new("UIStroke", {
		Color = settings.colors.secondary,
		Thickness = 1,
		Transparency = 0.5,
		Parent = sliderBg
	})

	local initialPercent =
		math.clamp(
			(defaultValue - min)
			/ (max - min),
			0,
			1
		)

	local sliderFill = new("Frame", {
		Size = UDim2.new(
			initialPercent,
			0,
			1,
			0
		),

		BackgroundColor3 =
			settings.colors.primary,

		BorderSizePixel = 0,
		Parent = sliderBg
	})

	local sliderButton = new("TextButton", {
		Size = UDim2.new(0, 12, 0, 12),
		Position = UDim2.new(
			initialPercent,
			-6,
			0.5,
			-6
		),

		BackgroundColor3 =
			settings.colors.primary,

		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = sliderBg
	})

	new("UIStroke", {
		Color = Color3.new(1, 1, 1),
		Thickness = 1,
		Parent = sliderButton
	})

	local dragging = false
	local currentValue = defaultValue

	local function updateValueFromMouse(mousePos)
		local absPos =
			sliderBg.AbsolutePosition

		local absSize =
			sliderBg.AbsoluteSize.X

		if absSize <= 0 then
			return
		end

		local relativeX =
			math.clamp(
				mousePos.X - absPos.X,
				0,
				absSize
			)

		local percent =
			relativeX / absSize

		local value =
			min + (max - min) * percent

		value =
			math.floor(value * 100) / 100

		currentValue = value

		sliderFill.Size =
			UDim2.new(
				percent,
				0,
				1,
				0
			)

		sliderButton.Position =
			UDim2.new(
				percent,
				-6,
				0.5,
				-6
			)

		valueLabel.Text =
			tostring(value)
			.. (unit or "")

		if callback then
			callback(value)
		end

		if settingsKey then
			SettingsStore:Set(
				settingsKey,
				value
			)
		end
	end

	sliderButton.MouseButton1Down:Connect(
		function(input)
			dragging = true
			updateValueFromMouse(
				input.Position
			)
		end
	)

	sliderBg.InputBegan:Connect(
		function(input)
			if input.UserInputType
				== Enum.UserInputType.MouseButton1 then

				dragging = true

				updateValueFromMouse(
					input.Position
				)
			end
		end
	)

	UserInputService.InputEnded:Connect(
		function(input)
			if input.UserInputType
				== Enum.UserInputType.MouseButton1 then

				dragging = false
			end
		end
	)

	UserInputService.InputChanged:Connect(
		function(input)
			if dragging
				and input.UserInputType
					== Enum.UserInputType.MouseMovement then

				updateValueFromMouse(
					UserInputService:GetMouseLocation()
				)
			end
		end
	)

	return frame
end

local function createKeybind(
	parent,
	text,
	defaultKey,
	callback,
	isToggleKey,
	settingsKey
)

	local frame = new("Frame", {
		Size = UDim2.new(1, 0, 0, 45),
		BackgroundTransparency = 1,
		Parent = parent
	})

	local label = new("TextLabel", {
