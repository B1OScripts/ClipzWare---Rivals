		local targetColor =
			isFriendList
			and Color3.fromRGB(150, 0, 0)
			or settings.colors.primary

		TweenService:Create(
			actionButton,
			TweenInfo.new(0.2),
			{
				BackgroundColor3 = targetColor,
				Size = UDim2.new(0, 60, 0, 25)
			}
		):Play()
	end)

	actionButton.MouseButton1Click:Connect(function()
		if isFriendList then
			FriendSystem:RemoveFriend(
				player.UserId
			)
		else
			FriendSystem:AddFriend(
				player.UserId
			)
		end
	end)

	return frame
end

local function updateFriendLists()

	for _, child in pairs(
		leftList:GetChildren()
	) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	for _, child in pairs(
		rightList:GetChildren()
	) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	local allPlayers = {}
	local friendPlayers = {}

	for _, player in Players:GetPlayers() do
		if player ~= Players.LocalPlayer then
			table.insert(
				allPlayers,
				player
			)

			if FriendSystem:IsFriend(
				player.UserId
			) then
				table.insert(
					friendPlayers,
					player
				)
			end
		end
	end

	table.sort(
		allPlayers,
		function(a, b)
			return a.Name < b.Name
		end
	)

	table.sort(
		friendPlayers,
		function(a, b)
			return a.Name < b.Name
		end
	)

	for _, player in ipairs(allPlayers) do
		createPlayerEntry(
			player,
			false
		)
	end

	for _, player in ipairs(friendPlayers) do
		createPlayerEntry(
			player,
			true
		)
	end

	if #friendPlayers == 0 then
		local emptyFrame = new("Frame", {
			Size = UDim2.new(1, -10, 0, 50),
			BackgroundTransparency = 1,
			Parent = rightList
		})

		new("TextLabel", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			Text = "No friends added yet",
			TextColor3 =
				settings.colors.textDark,
			Font = Enum.Font.Code,
			TextSize = 14,
			TextTransparency = 0.5,
			Parent = emptyFrame
		})
	end

	if #allPlayers == 0 then
		local emptyFrame = new("Frame", {
			Size = UDim2.new(1, -10, 0, 50),
			BackgroundTransparency = 1,
			Parent = leftList
		})

		new("TextLabel", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			Text = "No other players on server",
			TextColor3 =
				settings.colors.textDark,
			Font = Enum.Font.Code,
			TextSize = 14,
			TextTransparency = 0.5,
			Parent = emptyFrame
		})
	end
end

