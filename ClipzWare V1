local SettingsStore = {
	Data = {},
	FileName = "ClipzWare_Settings.txt"
}

function SettingsStore:Load()
	local success, data = pcall(function()
		return readfile(self.FileName)
	end)

	if success and data and data ~= "" then
		local success2, decoded = pcall(function()
			return HttpService:JSONDecode(data)
		end)

		if success2 and type(decoded) == "table" then
			self.Data = decoded
		else
			self.Data = {}
		end
	else
		self.Data = {}
	end

	return self.Data
end

function SettingsStore:Save()
	local success = pcall(function()
		local json = HttpService:JSONEncode(self.Data)
		writefile(self.FileName, json)
	end)

	return success
end

function SettingsStore:Get(key, defaultValue)
	if key:find("Key") then
		local saved = self.Data[key]

		if saved then
			if saved == "MouseButton2" then
				return Enum.UserInputType.MouseButton2
			elseif saved:find("Enum.") then
				local enumType, enumName = saved:match("Enum%.(%w+)%.(%w+)")

				if enumType and enumName then
					local enum = Enum[enumType]

					if enum and enum[enumName] then
						return enum[enumName]
					end
				end
			end
		end

		return defaultValue
	end

	if self.Data[key] ~= nil then
		return self.Data[key]
	end

	return defaultValue
end

function SettingsStore:Set(key, value, saveImmediately)
	if value == nil then
		self.Data[key] = nil
	elseif typeof(value) == "EnumItem" then
		self.Data[key] = tostring(value)
	else
		self.Data[key] = value
	end

	if saveImmediately ~= false then
		self:Save()
	end
end

SettingsStore:Load()

