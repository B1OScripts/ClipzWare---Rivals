local FriendSystem = {
	Friends = {},
	FileName = "ClipzWare_Friends.txt",
	ListUpdateCallbacks = {}
}

function FriendSystem:Load()
	local success, data = pcall(function()
		return readfile(self.FileName)
	end)

	if success and data and data ~= "" then
		local success2, decoded = pcall(function()
			return HttpService:JSONDecode(data)
		end)

		if success2 and type(decoded) == "table" then
			self.Friends = decoded
		else
			self.Friends = {}
		end
	else
		self.Friends = {}
	end

	return self.Friends
end

function FriendSystem:Save()
	local success = pcall(function()
		local json = HttpService:JSONEncode(self.Friends)
		writefile(self.FileName, json)
	end)

	return success
end

function FriendSystem:IsFriend(userId)
	return self.Friends[tostring(userId)] == true
end

function FriendSystem:AddFriend(userId)
	self.Friends[tostring(userId)] = true
	self:Save()
	self:UpdateAllLists()
end

function FriendSystem:RemoveFriend(userId)
	self.Friends[tostring(userId)] = nil
	self:Save()
	self:UpdateAllLists()
end

function FriendSystem:RegisterListUpdateCallback(name, callback)
	self.ListUpdateCallbacks[name] = callback
end

function FriendSystem:UpdateAllLists()
	for _, callback in pairs(self.ListUpdateCallbacks) do
		pcall(callback)
	end
end

