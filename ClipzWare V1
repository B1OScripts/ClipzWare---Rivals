			settings.colors.text,
		Font = Enum.Font.Code,
		TextSize = 14,
		TextXAlignment =
			Enum.TextXAlignment.Left,
		Parent = frame
	})

	local getKeyText = function(key)
		if not key then
			return "None"
		end

		if key == Enum.UserInputType.MouseButton2 then
			return "RMB"
		end

		if typeof(key) == "EnumItem" then
			return key.Name
		end

		return "None"
	end

	local keyButton = new("TextButton", {
		Size = UDim2.new(0, 70, 0, 30),
		Position = UDim2.new(
			1,
			-75,
			0.5,
			-15
		),

		BackgroundColor3 =
			settings.colors.backgroundLight,

		BorderSizePixel = 0,
		Text = getKeyText(defaultKey),
		TextColor3 =
			settings.colors.primary,
		Font = Enum.Font.Code,
		TextSize = 12,
		AutoButtonColor = false,
		Parent = frame
	})

	new("UIStroke", {
		Color = settings.colors.secondary,
		Thickness = 1,
		Transparency = 0.5,
		Parent = keyButton
	})

	local isWaitingForKey = false
	local currentKey = defaultKey

	keyButton.MouseButton1Click:Connect(function()
		isWaitingForKey = true
		keyButton.Text = "..."
		keyButton.TextColor3 =
			settings.colors.text
	end)

	UserInputService.InputBegan:Connect(
		function(input, gameProcessed)

			if gameProcessed then
				return
			end

			if isWaitingForKey then
				local newKey = nil

				if input.KeyCode
					~= Enum.KeyCode.Unknown then

					newKey = input.KeyCode

				elseif input.UserInputType
					== Enum.UserInputType.MouseButton2 then

					newKey =
						Enum.UserInputType.MouseButton2
				end

				if newKey then
					isWaitingForKey = false
					currentKey = newKey

					keyButton.Text =
						getKeyText(newKey)

					keyButton.TextColor3 =
						settings.colors.primary

					if callback then
						callback(newKey)
					end

					if settingsKey then
						SettingsStore:Set(
							settingsKey,
							newKey
						)
					end
				end
			end
		end
	)

	return frame
end

